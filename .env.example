# Database: PostgreSQL / Supabase
# Connect via standard PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DB_SSL=true

# Alternative individual parameters (if DATABASE_URL is not used):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=agencyos

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-at-least-16-characters-long"
TOKEN_ENCRYPTION_KEY="your-32-byte-token-encryption-key-for-integrations"

# Server Port (Local development)
PORT=4000

# Third-party Integrations (Optional - Google Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
